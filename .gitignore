# Visual Studio 2015 user specific files
.vs/*
.vsconfig

# Rider files
.idea/*

# Python cache files
__pycache__/
*.pyc

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*
Build/*/*/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Don't ignore PSO cache files
!Build/*/PipelineCaches/**

# Don't ignore Android res files
!Build/Android/res/**

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Content Developers and Collections files
Content/Collections/*
Content/Developers/*

# Don't ignore plugins third party
!Plugins/**/ThirdParty/
!Plugins/**/ThirdParty/**
!Plugins/**/Source/ThirdParty/**
!Plugins/DLSS/**/Binaries/ThirdParty/
!Plugins/DLSS/**/Binaries/ThirdParty/**
!Plugins/Audio/SteamAudio/Source/SteamAudioSDK/
!Plugins/Audio/SteamAudio/Source/SteamAudioSDK/**

# Orion browser CEF helper is a required runtime binary for installed-engine users.
!Plugins/OrionBrowser/Binaries/
Plugins/OrionBrowser/Binaries/*
!Plugins/OrionBrowser/Binaries/Win64/
Plugins/OrionBrowser/Binaries/Win64/*
!Plugins/OrionBrowser/Binaries/Win64/OrionBrowserHelper.exe

# Keep bundled agent tools trackable.
!.agents/**/*.exe
!.agents/**/*.dll

